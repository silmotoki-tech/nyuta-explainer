# Firebaseプロジェクトの設定値（Firebaseコンソール > プロジェクトの設定 > 全般 > マイアプリ で確認）
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 院内共通アカウント（Firebase Authentication > Users で作成したメール/パスワード）
# 追加・編集・並び替えの書き込み権限をこのアカウントに紐づける裏側の認証に使う
VITE_SHARED_ACCOUNT_EMAIL=
VITE_SHARED_ACCOUNT_PASSWORD=

# 編集モードを開くための6桁パスコード（アプリ内のUIゲート）
VITE_EDIT_PIN=
